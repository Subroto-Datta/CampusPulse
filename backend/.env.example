# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── DynamoDB ─────────────────────────────────────
# Table prefix for all CampusPulse tables
DYNAMODB_TABLE_PREFIX=CampusPulse_
# Set for local DynamoDB (e.g. docker run -p 8000:8000 amazon/dynamodb-local)
# Leave empty for real AWS DynamoDB
DYNAMODB_ENDPOINT=
# Set to 'true' to use in-memory mock DB (no AWS needed)
DB_MOCK=true

# ─── AWS ──────────────────────────────────────────
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,https://my-app-id.amplifyapp.com

# ─── AWS S3 (for uploads) ────────────────────────
AWS_S3_BUCKET=campuspulse-uploads
